// Settings live in their own window, not as a panel over the launcher.

import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import {
    KeyboardGlyph, CheckGlyph, PencilGlyph, PlusGlyph, Tabs, Switch, ShortcutChip, SettingRow, Card, Divider,
    SectionLabel, Slider, Button, TextField
} from "widgets.slint";

export struct ThemeOption {
    name: string,
    bg: color,
    surface: color,
    accent: color,
    text: color,
    custom: bool,
}

// A theme as a card: a miniature window in the theme's colours, then its name.
component ThemeCard inherits Rectangle {
    in property <ThemeOption> option;
    in property <bool> current;
    callback picked();
    callback edit();

    border-radius: 12px;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;
    border-width: root.current ? 2px : 1px;
    border-color: root.current ? Theme.accent : (touch.has-hover ? Theme.border-strong : Theme.border);
    animate background, border-color { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: root.option.name + " theme" + (root.current ? ", selected" : "");
    accessible-action-default => { root.picked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }

    // Preview
    Rectangle {
        x: 7px;
        y: 7px;
        width: parent.width - 14px;
        height: 60px;
        border-radius: 8px;
        background: root.option.bg;
        border-width: 1px;
        border-color: #8080801f;
        Rectangle {
            x: 8px;
            y: 8px;
            width: parent.width * 0.42;
            height: parent.height - 16px;
            border-radius: 6px;
            background: root.option.surface;
            Rectangle {
                x: 6px;
                y: 7px;
                width: parent.width - 12px;
                height: 4px;
                border-radius: 2px;
                background: root.option.text;
                opacity: 0.8;
            }
            Rectangle {
                x: 6px;
                y: 15px;
                width: (parent.width - 12px) * 0.6;
                height: 4px;
                border-radius: 2px;
                background: root.option.text;
                opacity: 0.4;
            }
        }
        Rectangle {
            x: parent.width * 0.42 + 16px;
            y: 8px;
            width: 20px;
            height: 20px;
            border-radius: 6px;
            background: root.option.accent;
        }
        Rectangle {
            x: parent.width * 0.42 + 16px;
            y: 34px;
            width: max(0px, parent.width * 0.58 - 26px);
            height: 5px;
            border-radius: 2.5px;
            background: root.option.text;
            opacity: 0.55;
        }
    }

    HorizontalLayout {
        y: 72px;
        height: parent.height - 72px;
        padding-left: 10px;
        padding-right: 6px;
        spacing: 4px;
        Text {
            text: root.option.name;
            font-size: 12.5px;
            font-weight: root.current ? 700 : 500;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.current: VerticalLayout {
            alignment: center;
            CheckGlyph { width: 15px; height: 15px; stroke: Theme.accent; stroke-width: 2.2px; }
        }
        if root.option.custom: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: edit-touch.has-hover ? Theme.border : transparent;
                accessible-role: button;
                accessible-label: "Edit " + root.option.name;
                accessible-action-default => { root.edit(); }
                PencilGlyph { width: 14px; height: 14px; }
                edit-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.edit(); }
                }
            }
        }
    }
}

component CreateThemeCard inherits Rectangle {
    callback clicked();
    border-radius: 12px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.border-strong;
    background: touch.has-hover ? Theme.accent-soft : transparent;
    animate background, border-color { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: "Create theme";
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Theme.accent-soft;
                PlusGlyph { width: 18px; height: 18px; stroke: Theme.accent; stroke-width: 2.2px; }
            }
        }
        Text {
            text: "Create theme";
            font-size: 12.5px;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Label + live swatch + hex field.
component ColorField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <color> swatch;
    in property <bool> valid: true;
    spacing: 4px;
    horizontal-stretch: 1;
    Text {
        text: root.label;
        font-size: 11.5px;
        font-weight: 600;
        color: Theme.text-muted;
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: root.swatch;
            border-width: 1px;
            border-color: root.valid ? Theme.border-strong : Theme.danger;
        }
        TextField {
            height: 32px;
            horizontal-stretch: 1;
            text <=> root.value;
            placeholder: "#RRGGBB";
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Launchpad Settings";
    icon: root.app-icon;
    preferred-width: 540px;
    preferred-height: 620px;
    min-width: 440px;
    min-height: 420px;
    background: Theme.bg;
    default-font-size: 13px;

    in property <bool> dark: true;
    in property <image> app-icon;
    in-out property <int> page;

    in property <string> hotkey;           // display label, "" when unset
    in property <bool> capturing;
    in property <string> hotkey-note;      // error or hint under the shortcut
    in property <bool> hotkey-note-is-error;
    in property <bool> hotkey-on-release;
    in property <bool> hide-on-launch;
    in property <bool> keep-on-top;
    in property <bool> close-to-tray;
    in property <bool> auto-start;

    in property <[ThemeOption]> themes;
    in property <int> theme-index;
    in property <float> icon-size;
    in property <float> spacing;
    in property <bool> auto-fit;

    in property <string> version;
    in property <string> config-path;
    in property <bool> portable;

    callback start-capture();
    callback key-captured(string, bool, bool, bool, bool);
    callback cancel-capture();
    callback clear-hotkey();
    callback set-flag(string, bool);
    callback pick-theme(int);
    callback set-icon-size(float);
    callback set-spacing(float);
    callback open-config-dir();
    callback open-url(string);

    // Theme editor ("" name = closed)
    in property <bool> editor-open;
    in property <bool> editor-new;
    in property <string> editor-error;
    in-out property <string> ed-name;
    in-out property <string> ed-bg;
    in-out property <string> ed-surface;
    in-out property <string> ed-hover;
    in-out property <string> ed-accent;
    in-out property <string> ed-border;
    in-out property <string> ed-text;
    callback create-theme();
    callback edit-theme(int);
    callback save-theme();
    callback cancel-theme();
    callback delete-theme();
    pure callback hex-color(string) -> color;
    pure callback hex-valid(string) -> bool;

    init => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark => {
        Palette.color-scheme = root.dark ? ColorScheme.dark : ColorScheme.light;
    }

    function begin-capture() {
        if (root.capturing) {
            root.cancel-capture();
        } else {
            root.start-capture();
            key-sink.focus();
        }
    }

    // Receives the key combo while the shortcut chip is recording.
    key-sink := FocusScope {
        key-pressed(event) => {
            if (root.editor-open && event.text == Key.Escape) {
                root.cancel-theme();
                return accept;
            }
            if (root.capturing) {
                root.key-captured(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Image { source: root.app-icon; width: 24px; height: 24px; }
                }
                Text {
                    text: "Settings";
                    font-size: 17px;
                    font-weight: 750;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Tabs {
                        items: ["General", "Appearance", "About"];
                        selected <=> root.page;
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 4px;
                    padding-bottom: 18px;
                    spacing: 10px;
                    alignment: start;

                    // ── General ──
                    if root.page == 0: VerticalLayout {
                        spacing: 10px;
                        SectionLabel { text: "SHORTCUT"; }
                        Card {
                            VerticalLayout {
                                SettingRow {
                                    title: "Show / hide Launchpad";
                                    subtitle: "Works from anywhere. Click, then press the keys you want.";
                                    ShortcutChip {
                                        shortcut: root.hotkey;
                                        capturing: root.capturing;
                                        placeholder: "Not set";
                                        label: "Show or hide shortcut";
                                        clicked => { root.begin-capture(); }
                                        cleared => { root.clear-hotkey(); }
                                    }
                                }
                                if root.hotkey-note != "": HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    padding-bottom: 12px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        alignment: start;
                                        KeyboardGlyph {
                                            width: 15px;
                                            height: 15px;
                                            stroke: root.hotkey-note-is-error ? Theme.danger : Theme.accent;
                                        }
                                    }
                                    Text {
                                        text: root.hotkey-note;
                                        font-size: 12px;
                                        color: root.hotkey-note-is-error ? Theme.danger : Theme.accent;
                                        wrap: word-wrap;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Divider { }
                                SettingRow {
                                    title: "Trigger on key release";
                                    subtitle: "Open when the keys are let go, so the key-up doesn't reach the window underneath.";
                                    Switch {
                                        label: "Trigger on key release";
                                        checked: root.hotkey-on-release;
                                        toggled(v) => { root.set-flag("hotkey-on-release", v); }
                                    }
                                }
                            }
                        }

                        SectionLabel { text: "BEHAVIOUR"; }
                        Card {
                            VerticalLayout {
                                SettingRow {
                                    title: "Hide after launching";
                                    subtitle: "Get out of the way once an app or folder opens.";
                                    Switch {
                                        label: "Hide after launching";
                                        checked: root.hide-on-launch;
                                        toggled(v) => { root.set-flag("hide-on-launch", v); }
                                    }
                                }
                                Divider { }
                                SettingRow {
                                    title: "Keep on top";
                                    subtitle: "Stay above other windows while open.";
                                    Switch {
                                        label: "Keep on top";
                                        checked: root.keep-on-top;
                                        toggled(v) => { root.set-flag("keep-on-top", v); }
                                    }
                                }
                                Divider { }
                                SettingRow {
                                    title: "Close to tray";
                                    subtitle: "The window's close button hides Launchpad instead of quitting. Quit from the tray icon.";
                                    Switch {
                                        label: "Close to tray";
                                        checked: root.close-to-tray;
                                        toggled(v) => { root.set-flag("close-to-tray", v); }
                                    }
                                }
                                Divider { }
                                SettingRow {
                                    title: "Start with Windows";
                                    subtitle: "Launch in the tray when you sign in.";
                                    Switch {
                                        label: "Start with Windows";
                                        checked: root.auto-start;
                                        toggled(v) => { root.set-flag("auto-start", v); }
                                    }
                                }
                            }
                        }
                    }

                    // ── Appearance ──
                    if root.page == 1: VerticalLayout {
                        spacing: 10px;
                        SectionLabel { text: "THEME"; }
                        Rectangle {
                            property <length> gap: 10px;
                            property <int> cols: max(2, floor((self.width + self.gap) / (150px + self.gap)));
                            property <length> card-w: (self.width - (self.cols - 1) * self.gap) / self.cols;
                            property <length> card-h: 106px;
                            property <int> count: root.themes.length + 1;   // + "Create theme"
                            height: ceil(self.count / self.cols) * (self.card-h + self.gap) - self.gap;
                            for option[i] in root.themes: ThemeCard {
                                x: mod(i, parent.cols) * (parent.card-w + parent.gap);
                                y: floor(i / parent.cols) * (parent.card-h + parent.gap);
                                width: parent.card-w;
                                height: parent.card-h;
                                option: option;
                                current: i == root.theme-index;
                                picked => { root.pick-theme(i); }
                                edit => { root.edit-theme(i); }
                            }
                            CreateThemeCard {
                                x: mod(root.themes.length, parent.cols) * (parent.card-w + parent.gap);
                                y: floor(root.themes.length / parent.cols) * (parent.card-h + parent.gap);
                                width: parent.card-w;
                                height: parent.card-h;
                                clicked => { root.create-theme(); }
                            }
                        }

                        SectionLabel { text: "LAYOUT"; }
                        Card {
                            VerticalLayout {
                                SettingRow {
                                    title: "Fit icons to window";
                                    subtitle: "Size icons so every item fits without scrolling.";
                                    Switch {
                                        label: "Fit icons to window";
                                        checked: root.auto-fit;
                                        toggled(v) => { root.set-flag("auto-fit", v); }
                                    }
                                }
                                Divider { }
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    opacity: root.auto-fit ? 0.45 : 1;
                                    HorizontalLayout {
                                        Text { text: "Icon size"; font-size: 13.5px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
                                        Text { text: root.auto-fit ? "Automatic" : round(root.icon-size) + " px"; font-size: 12px; color: Theme.text-muted; }
                                    }
                                    Slider {
                                        label: "Icon size";
                                        minimum: 32;
                                        maximum: 128;
                                        step: 4;
                                        value: root.icon-size;
                                        moved(v) => { root.set-icon-size(v); }
                                    }
                                }
                                Divider { }
                                VerticalLayout {
                                    padding: 16px;
                                    spacing: 10px;
                                    HorizontalLayout {
                                        Text { text: "Spacing"; font-size: 13.5px; font-weight: 600; color: Theme.text; horizontal-stretch: 1; }
                                        Text { text: round(root.spacing) + " px"; font-size: 12px; color: Theme.text-muted; }
                                    }
                                    Slider {
                                        label: "Spacing";
                                        minimum: 0;
                                        maximum: 40;
                                        step: 2;
                                        value: root.spacing;
                                        moved(v) => { root.set-spacing(v); }
                                    }
                                }
                            }
                        }
                    }

                    // ── About ──
                    if root.page == 2: VerticalLayout {
                        spacing: 10px;
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: start;
                                    Image { source: root.app-icon; width: 40px; height: 40px; }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 6px;
                                            alignment: start;
                                            Text { text: "Launchpad " + root.version; font-size: 15px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                            Text { text: "by X4Lo"; font-size: 12.5px; color: Theme.text-muted; vertical-alignment: center; }
                                        }
                                        Text { text: "A fast, lightweight app launcher"; font-size: 12px; color: Theme.text-muted; }
                                    }
                                }
                                Divider { }
                                Text {
                                    text: (root.portable ? "Portable mode · " : "Standard mode · ") + "settings file:";
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                }
                                Text {
                                    text: root.config-path;
                                    font-size: 12px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    padding-top: 4px;
                                    spacing: 8px;
                                    Button {
                                        text: "GitHub ↗";
                                        clicked => { root.open-url("https://github.com/X4Lo/LaunchPad"); }
                                    }
                                    Button {
                                        text: "Open settings folder";
                                        clicked => { root.open-config-dir(); }
                                    }
                                }
                                Text {
                                    text: "github.com/X4Lo/LaunchPad · MIT License";
                                    font-size: 11px;
                                    color: Theme.text-faint;
                                }
                            }
                        }
                        SectionLabel { text: "KEYBOARD"; }
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 6px;
                                for row in [
                                    { k: "Type", v: "Search everything" },
                                    { k: "Arrows · Enter", v: "Move the selection · open it" },
                                    { k: "Esc", v: "Clear search, leave a group, then hide" },
                                    { k: "Backspace", v: "Leave a group" },
                                    { k: "Mouse back · forward", v: "Leave a group · go back into it" },
                                    { k: "Shift + F10", v: "Menu for the selected item" },
                                    { k: "F2 · Del", v: "Rename · remove the selected item" },
                                    { k: "Ctrl + ,", v: "Open these settings" },
                                ]: HorizontalLayout {
                                    spacing: 12px;
                                    Text { width: 140px; text: row.k; font-size: 12px; font-weight: 600; color: Theme.text; }
                                    Text { text: row.v; font-size: 12px; color: Theme.text-muted; wrap: word-wrap; horizontal-stretch: 1; }
                                }
                            }
                        }
                        Text {
                            text: "Built with Slint (slint.dev) under its royalty-free license.";
                            font-size: 11px;
                            color: Theme.text-faint;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── Theme editor ──
        if root.editor-open: Rectangle {
            background: Theme.scrim;
            TouchArea { }   // modal: swallow clicks on the scrim
            VerticalLayout {
                alignment: center;
                padding: 16px;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: min(480px, root.width - 32px);
                        background: Theme.surface;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        drop-shadow-blur: 30px;
                        drop-shadow-offset-y: 10px;
                        drop-shadow-color: #00000070;
                        TouchArea { }
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            Text {
                                text: root.editor-new ? "Create theme" : "Edit theme";
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text;
                            }

                            // Live preview with the colours being edited.
                            Rectangle {
                                height: 74px;
                                border-radius: 10px;
                                background: root.hex-color(root.ed-bg);
                                border-width: 1px;
                                border-color: root.hex-color(root.ed-border);
                                HorizontalLayout {
                                    padding: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        border-radius: 8px;
                                        background: root.hex-color(root.ed-surface);
                                        border-width: 1px;
                                        border-color: root.hex-color(root.ed-border);
                                        horizontal-stretch: 1;
                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            Text {
                                                text: root.ed-name == "" ? "Preview" : root.ed-name;
                                                font-size: 13px;
                                                font-weight: 700;
                                                color: root.hex-color(root.ed-text);
                                                vertical-alignment: center;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 86px;
                                        border-radius: 8px;
                                        background: root.hex-color(root.ed-hover);
                                        Text {
                                            text: "Hover";
                                            font-size: 12px;
                                            color: root.hex-color(root.ed-text);
                                        }
                                    }
                                    Rectangle {
                                        width: 86px;
                                        border-radius: 8px;
                                        background: root.hex-color(root.ed-accent);
                                        Text {
                                            text: "Accent";
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: white;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "Name"; font-size: 11.5px; font-weight: 600; color: Theme.text-muted; }
                                TextField {
                                    text <=> root.ed-name;
                                    placeholder: "My theme";
                                    init => { self.focus-input(); self.select-all(); }
                                    accepted => { root.save-theme(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                ColorField { label: "Background"; value <=> root.ed-bg; swatch: root.hex-color(root.ed-bg); valid: root.hex-valid(root.ed-bg); }
                                ColorField { label: "Cards & menus"; value <=> root.ed-surface; swatch: root.hex-color(root.ed-surface); valid: root.hex-valid(root.ed-surface); }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                ColorField { label: "Hover"; value <=> root.ed-hover; swatch: root.hex-color(root.ed-hover); valid: root.hex-valid(root.ed-hover); }
                                ColorField { label: "Accent"; value <=> root.ed-accent; swatch: root.hex-color(root.ed-accent); valid: root.hex-valid(root.ed-accent); }
                            }
                            HorizontalLayout {
                                spacing: 12px;
                                ColorField { label: "Borders"; value <=> root.ed-border; swatch: root.hex-color(root.ed-border); valid: root.hex-valid(root.ed-border); }
                                ColorField { label: "Text"; value <=> root.ed-text; swatch: root.hex-color(root.ed-text); valid: root.hex-valid(root.ed-text); }
                            }
                            if root.editor-error != "": Text {
                                text: root.editor-error;
                                font-size: 12px;
                                color: Theme.danger;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                padding-top: 4px;
                                if !root.editor-new: Button {
                                    text: "Delete";
                                    danger: true;
                                    clicked => { root.delete-theme(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: "Cancel";
                                    clicked => { root.cancel-theme(); }
                                }
                                Button {
                                    text: root.editor-new ? "Create" : "Save";
                                    primary: true;
                                    clicked => { root.save-theme(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
