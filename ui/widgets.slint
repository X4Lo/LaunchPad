// ── Controls ──────────────────────────────────────────────────────────────────

export component IconButton inherits Rectangle {
    callback clicked;
    in property <string> tooltip;
    in property <bool> active;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: active ? Theme.accent-soft : (touch.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked;

    height: 32px;
    min-width: 76px;
    border-radius: 8px;
    border-width: primary || danger ? 0 : 1px;
    border-color: Theme.border-strong;
    background: !enabled ? Theme.surface-sunken
        : primary ? (touch.pressed ? Theme.accent-strong : touch.has-hover ? Theme.accent-strong : Theme.accent)
        : danger ? (touch.has-hover ? Theme.danger : Theme.danger-soft)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);
    opacity: enabled ? 1 : 0.55;
    animate background { duration: Theme.fast; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            font-size: 12.5px;
            font-weight: 600;
            color: root.primary ? Theme.on-accent : root.danger ? (touch.has-hover ? white : Theme.danger) : Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Single-line text field. `leading` shows a search glyph.
export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> leading;
    in property <length> field-font-size: 13px;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    public function focus-input() { input.focus(); }
    public function select-all() { input.select-all(); }

    height: 36px;
    border-radius: 10px;
    background: Theme.surface-sunken;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: root.leading ? 10px : 12px;
        padding-right: 6px;
        spacing: 8px;
        if root.leading: VerticalLayout {
            alignment: center;
            SearchGlyph { width: 16px; height: 16px; stroke: input.has-focus ? Theme.accent : Theme.text-faint; }
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.text-faint;
                font-size: root.field-font-size;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: root.field-font-size;
                selection-background-color: Theme.accent;
                selection-foreground-color: Theme.on-accent;
                accessible-label: root.placeholder;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }
        @children
    }
}

export component Tabs inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected;
    callback picked(int);
    height: 32px;
    border-radius: 10px;
    background: Theme.surface-sunken;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for item[i] in root.items: Rectangle {
            border-radius: 7px;
            background: i == root.selected ? Theme.surface : transparent;
            drop-shadow-blur: i == root.selected ? 4px : 0;
            drop-shadow-color: #0000001f;
            animate background { duration: Theme.fast; }
            accessible-role: tab;
            accessible-label: item;
            accessible-action-default => { root.selected = i; root.picked(i); }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: item;
                    font-size: 12.5px;
                    font-weight: i == root.selected ? 600 : 500;
                    color: i == root.selected ? Theme.text : Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected = i; root.picked(i); }
            }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> label;
    callback toggled(bool);
    width: 40px;
    height: 23px;
    border-radius: self.height / 2;
    background: checked ? Theme.accent : Theme.border-strong;
    animate background { duration: Theme.fast; }
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    accessible-action-default => { touch.clicked(); }
    Rectangle {
        width: parent.height - 6px;
        height: self.width;
        y: 3px;
        x: root.checked ? parent.width - self.width - 3px : 3px;
        border-radius: self.width / 2;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        animate x { duration: 160ms; easing: ease-out; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// Click → "Press keys…" → shows the captured combo. × clears it.
export component ShortcutChip inherits Rectangle {
    in property <string> shortcut;
    in property <bool> capturing;
    in property <string> placeholder: "Set shortcut";
    in property <string> label;
    callback clicked;
    callback cleared;

    property <bool> blink;
    property <bool> bound: shortcut != "";

    height: 32px;
    min-width: 140px;
    border-radius: 8px;
    border-width: 1px;
    border-color: capturing ? Theme.accent : (bound ? Theme.border-strong : Theme.border);
    background: capturing ? Theme.accent-soft : (bound ? Theme.surface-sunken : (touch.has-hover ? Theme.surface-hover : transparent));
    animate background, border-color { duration: Theme.fast; }

    accessible-role: button;
    accessible-label: label + ": " + (capturing ? "press a key combination" : (bound ? shortcut : "not set"));
    accessible-action-default => { root.clicked(); }

    Timer {
        interval: 450ms;
        running: root.capturing;
        triggered => { root.blink = !root.blink; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.bound && !root.capturing ? 4px : 10px;
        spacing: 6px;
        if root.capturing: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.accent;
            opacity: root.blink ? 0.25 : 1;
            animate opacity { duration: 200ms; }
        }
        Text {
            text: root.capturing ? "Press keys…" : (root.bound ? root.shortcut : root.placeholder);
            font-size: 12px;
            font-weight: root.bound && !root.capturing ? 600 : 500;
            color: root.capturing ? Theme.accent : (root.bound ? Theme.text : Theme.text-muted);
            vertical-alignment: center;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.bound && !root.capturing: Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: clear.has-hover ? Theme.border : transparent;
            accessible-role: button;
            accessible-label: "Clear shortcut";
            accessible-action-default => { root.cleared(); }
            CloseGlyph { width: 13px; height: 13px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            clear := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.cleared(); }
            }
        }
    }
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    min-height: 58px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.title; font-size: 13.5px; font-weight: 600; color: Theme.text; }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 12px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    @children
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component SectionLabel inherits Text {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: Theme.text-faint;
}

// Horizontal slider snapping to `step`. The knob follows the pointer locally while
// dragging so updates from Rust never make it jump.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 1;
    in property <string> label;
    callback moved(float);

    property <float> drag-value;
    property <float> shown: touch.pressed ? drag-value : clamp(value, minimum, maximum);
    property <float> frac: (root.shown - root.minimum) / max(0.0001, root.maximum - root.minimum);
    property <length> knob: 16px;

    height: 24px;
    min-width: 120px;

    accessible-role: slider;
    accessible-label: label;
    accessible-value: round(root.shown);
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { root.moved(min(root.maximum, root.value + root.step)); }
    accessible-action-decrement => { root.moved(max(root.minimum, root.value - root.step)); }

    function set-from(x: length) {
        root.drag-value = root.minimum + round(clamp((x - root.knob / 2) / max(1px, root.width - root.knob), 0, 1) * (root.maximum - root.minimum) / root.step) * root.step;
        root.moved(root.drag-value);
    }

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.border-strong;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        height: 4px;
        width: (root.width - root.knob) * root.frac + root.knob / 2;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: (root.width - root.knob) * root.frac;
        y: (parent.height - root.knob) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: white;
        border-width: 1px;
        border-color: touch.has-hover || touch.pressed ? Theme.accent : Theme.border-strong;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// One row in a popup menu: a glyph slot, a label, optional hint on the right.
export component MenuEntry inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> danger;
    callback clicked;

    height: 32px;
    border-radius: 7px;
    background: touch.has-hover ? (danger ? Theme.danger-soft : Theme.surface-hover) : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            width: 17px;
            alignment: center;
            @children
        }
        Text {
            text: root.text;
            font-size: 12.5px;
            color: root.danger ? Theme.danger : Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 11.5px;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

// Rounded popup panel used by menus.
export component MenuPanel inherits Rectangle {
    background: Theme.surface;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000066;
    VerticalLayout {
        padding: 5px;
        spacing: 1px;
        @children
    }
}
