// Reusable building blocks (shared design with HushKey). Everything is drawn with Slint
// primitives (no icon fonts, no image assets) so it renders identically everywhere.

import { Theme } from "theme.slint";

// ── Glyphs ────────────────────────────────────────────────────────────────────
// 24×24 stroke icons. Each one has a constant path so the compiler validates it.

component Glyph inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: Theme.text-muted;
    stroke-width: 1.8px;
    fill: transparent;
}

export component SearchGlyph inherits Glyph {
    commands: "M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14z M16.2 16.2L20.5 20.5";
}

export component PlusGlyph inherits Glyph {
    commands: "M12 5v14 M5 12h14";
}

